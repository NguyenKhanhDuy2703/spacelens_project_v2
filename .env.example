# =============================================================
# SpaceLens Project — Root .env.example
# Copy file này thành .env và điền giá trị thực
# =============================================================

# ─── SHARED INFRASTRUCTURE ────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# ─── API GATEWAY ──────────────────────────────────────────────
GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:5173

# ─── AUTH SERVICE ─────────────────────────────────────────────
AUTH_PORT=3001
AUTH_DB_NAME=spacelens_auth
AUTH_JWT_SECRET=your-super-secret-key-change-this
AUTH_JWT_EXPIRES_IN=7d

# ─── CAMERA SERVICE ───────────────────────────────────────────
CAMERA_PORT=3002
CAMERA_DB_NAME=spacelens_camera

# ─── ZONE SERVICE ─────────────────────────────────────────────
ZONE_PORT=3003
ZONE_DB_NAME=spacelens_zone

# ─── ANALYTICS SERVICE ────────────────────────────────────────
ANALYTICS_PORT=3004
ANALYTICS_DB_NAME=spacelens_analytics
ANALYTICS_WORKER_CONCURRENCY=2

# ─── REPORT SERVICE ───────────────────────────────────────────
REPORT_PORT=3005
REPORT_DB_NAME=spacelens_report

# ─── MODULE AI ────────────────────────────────────────────────
AI_MODULE_URL=http://localhost:5000
AI_PORT=5000

# ─── MODULE FE ────────────────────────────────────────────────
FE_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ─── AWS / CLOUD (production) ─────────────────────────────────
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
